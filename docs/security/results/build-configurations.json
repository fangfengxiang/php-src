{
  "baseline-debug": {
    "CC": "gcc",
    "CFLAGS": "$(CFLAGS_CLEAN) -prefer-non-pic -static",
    "LDFLAGS": null,
    "CONFIGURE_COMMAND": "'./configure' '--prefix=/work/install' '--enable-debug' '--enable-cli' '--enable-cgi' '--enable-fpm' '--without-pear' '--without-pcre-jit' '--with-zlib' '--enable-pcntl' '--enable-posix' '--enable-sockets' 'LDFLAGS='",
    "hardened": "baseline",
    "debug": true,
    "CFLAGS_CLEAN": "-I/usr/include -g3 -fcommon -fvisibility=hidden -O0 -Wall $(PROF_FLAGS)"
  },
  "patched-debug": {
    "CC": "gcc",
    "CFLAGS": "$(CFLAGS_CLEAN) -prefer-non-pic -static",
    "LDFLAGS": null,
    "CONFIGURE_COMMAND": "'./configure' '--prefix=/work/install' '--enable-debug' '--enable-php70-security' '--enable-cli' '--enable-cgi' '--enable-fpm' '--without-pear' '--without-pcre-jit' '--with-zlib' '--enable-pcntl' '--enable-posix' '--enable-sockets' 'LDFLAGS='",
    "hardened": "1",
    "debug": true,
    "CFLAGS_CLEAN": "-I/usr/include -g3 -fcommon -fvisibility=hidden -O0 -Wall $(PROF_FLAGS)"
  },
  "patched-asan": {
    "CC": "gcc",
    "CFLAGS": "$(CFLAGS_CLEAN) -prefer-non-pic -static",
    "LDFLAGS": null,
    "CONFIGURE_COMMAND": "'./configure' '--prefix=/work/install' '--enable-debug' '--enable-php70-security' '--enable-cli' '--enable-cgi' '--enable-fpm' '--without-pear' '--without-pcre-jit' '--with-zlib' '--enable-pcntl' '--enable-posix' '--enable-sockets'",
    "hardened": "1",
    "debug": true,
    "CFLAGS_CLEAN": "-I/usr/include -g3 -fcommon -fno-omit-frame-pointer -fsanitize=address -fvisibility=hidden -O0 -Wall $(PROF_FLAGS)"
  },
  "patched-release": {
    "CC": "gcc",
    "CFLAGS": "$(CFLAGS_CLEAN) -prefer-non-pic -static",
    "LDFLAGS": null,
    "CONFIGURE_COMMAND": "'./configure' '--prefix=/work/install' '--disable-debug' '--enable-php70-security' '--enable-cli' '--enable-cgi' '--enable-fpm' '--without-pear' '--without-pcre-jit' '--with-zlib' '--enable-pcntl' '--enable-posix' '--enable-sockets' 'LDFLAGS='",
    "hardened": "1",
    "debug": false,
    "CFLAGS_CLEAN": "-I/usr/include -O2 -g -fcommon -fvisibility=hidden $(PROF_FLAGS)"
  },
  "mode-legacy": {
    "CC": "gcc",
    "CFLAGS": "$(CFLAGS_CLEAN) -prefer-non-pic -static",
    "LDFLAGS": null,
    "CONFIGURE_COMMAND": "'./configure' '--prefix=/work/install' '--enable-debug' '--disable-php70-security' '--enable-cli' '--enable-cgi' '--enable-fpm' '--without-pear' '--without-pcre-jit' '--with-zlib' '--enable-pcntl' '--enable-posix' '--enable-sockets' 'LDFLAGS='",
    "hardened": "0",
    "debug": true,
    "CFLAGS_CLEAN": "-I/usr/include -g3 -fcommon -fvisibility=hidden -O0 -Wall $(PROF_FLAGS)"
  }
}
